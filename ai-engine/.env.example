WAYFINDER_AI_HOST=127.0.0.1
WAYFINDER_AI_PORT=8000
WAYFINDER_AI_ENV=development

# Future provider settings. Keep empty in the public repo.
WAYFINDER_LLM_PROVIDER=
WAYFINDER_LLM_MODEL=
WAYFINDER_LLM_API_KEY=

# Future vector store settings.
WAYFINDER_VECTOR_PROVIDER=
WAYFINDER_VECTOR_URL=
WAYFINDER_VECTOR_API_KEY=
WAYFINDER_VECTOR_COLLECTION=wayfinder_places

# Operational controls.
WAYFINDER_AI_REQUEST_TIMEOUT_SECONDS=10
WAYFINDER_AI_ENABLE_EXPERIMENTAL_MODELS=false
