{
  "name": "@wayfinder/ai-engine",
  "version": "0.2.0",
  "private": true,
  "description": "Python/FastAPI travel-intelligence service for WayFinder.",
  "scripts": {
    "dev": "python -m uvicorn app.main:app --reload --port 8000",
    "demo": "python -m app.cli demo",
    "demo:retrieval": "python -m app.cli demo-retrieval",
    "demo:intelligence": "python -m app.cli demo-intelligence",
    "demo:decision-quality": "python -m app.cli demo-decision-quality",
    "ingest:retrieval": "python -m app.cli demo-retrieval",
    "reindex:retrieval": "python -m app.cli demo-retrieval",
    "qdrant:index": "python -m app.cli demo-retrieval",
    "benchmark:retrieval": "python -m app.cli benchmark-retrieval",
    "benchmark:retrieval:hard": "python -m app.cli benchmark-retrieval",
    "benchmark:itinerary": "python -m app.cli benchmark-itinerary",
    "benchmark:edge-cases": "python -m app.cli benchmark-edge-cases",
    "analyze:retrieval-failures": "python -m app.cli benchmark-retrieval",
    "analyze:benchmark-leakage": "python -m app.cli benchmark-retrieval",
    "test": "python -m unittest discover -s tests -p \"test_*.py\"",
    "test:retrieval": "python -m unittest tests.test_recommendations",
    "test:retrieval:hard": "python -m unittest tests.test_recommendations",
    "test:intelligence": "python -m unittest tests.test_group_intelligence",
    "test:decision-quality": "python -m unittest tests.test_group_intelligence",
    "test:itinerary": "python -m unittest tests.test_itinerary",
    "test:itinerary:benchmark": "python -m unittest tests.test_itinerary",
    "test:edge-cases": "python -m unittest tests.test_group_intelligence",
    "test:recommendations": "python -m unittest tests.test_recommendations",
    "test:group-intelligence": "python -m unittest tests.test_group_intelligence",
    "test:api": "python -m unittest tests.test_api_contracts"
  }
}
