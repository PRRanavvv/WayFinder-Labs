{
  "name": "@wayfinder/ai-engine",
  "version": "0.2.0",
  "private": true,
  "description": "Python/FastAPI travel-intelligence service for WayFinder.",
  "scripts": {
    "dev": "python -m uvicorn app.main:app --reload --port 8000",
    "demo": "python -m scripts.demo",
    "evaluate": "python -m evals.runner",
    "test": "python -m unittest discover -s tests -p \"test_*.py\"",
    "test:unit": "python -m unittest discover -s tests/unit -p \"test_*.py\"",
    "test:contract": "python -m unittest discover -s tests/contract -p \"test_*.py\"",
    "test:evaluation": "python -m unittest discover -s tests/evaluation -p \"test_*.py\""
  }
}
